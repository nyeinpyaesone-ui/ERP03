{
  "info": {
    "name": "ERP03 API Collection",
    "description": "Postman collection for ERP03 backend API — auth flow, sales, products, customers, health.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "Health",
      "item": [
        {
          "name": "GET /api/v1/healthz",
          "request": {
            "method": "GET",
            "url": { "raw": "{{base_url}}/api/v1/healthz", "host": ["{{base_url}}"], "path": ["api","v1","healthz"] }
          }
        }
      ]
    },
    {
      "name": "Auth",
      "item": [
        {
          "name": "POST /api/v1/auth/register",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\"business_code\":\"TESTBIZ\",\"email\":\"test@example.com\",\"password\":\"test123456\",\"display_name\":\"Test User\"}" },
            "url": { "raw": "{{base_url}}/api/v1/auth/register", "host": ["{{base_url}}"], "path": ["api","v1","auth","register"] }
          }
        },
        {
          "name": "POST /api/v1/auth/login",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\"business_code\":\"TESTBIZ\",\"email\":\"test@example.com\",\"password\":\"test123456\"}" },
            "url": { "raw": "{{base_url}}/api/v1/auth/login", "host": ["{{base_url}}"], "path": ["api","v1","auth","login"] }
          }
        },
        {
          "name": "GET /api/v1/auth/me",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{access_token}}" }],
            "url": { "raw": "{{base_url}}/api/v1/auth/me", "host": ["{{base_url}}"], "path": ["api","v1","auth","me"] }
          }
        }
      ]
    },
    {
      "name": "Sales",
      "item": [
        {
          "name": "POST /api/v1/sales",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{access_token}}" },
              { "key": "X-Idempotency-Key", "value": "{{$guid}}" }
            ],
            "body": { "mode": "raw", "raw": "{\"customer_id\":null,\"payment_method\":\"cash\",\"items\":[{\"product_id\":\"{{product_id}}\",\"quantity\":2,\"unit_price\":5000}],\"idempotency_key\":\"{{$guid}}\"}" },
            "url": { "raw": "{{base_url}}/api/v1/sales", "host": ["{{base_url}}"], "path": ["api","v1","sales"] }
          }
        },
        {
          "name": "GET /api/v1/sales",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{access_token}}" }],
            "url": { "raw": "{{base_url}}/api/v1/sales?limit=10&offset=0", "host": ["{{base_url}}"], "path": ["api","v1","sales"], "query": [{ "key": "limit", "value": "10" },{ "key": "offset", "value": "0" }] }
          }
        }
      ]
    },
    {
      "name": "Products",
      "item": [
        {
          "name": "GET /api/v1/products",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{access_token}}" }],
            "url": { "raw": "{{base_url}}/api/v1/products?limit=10&offset=0", "host": ["{{base_url}}"], "path": ["api","v1","products"], "query": [{ "key": "limit", "value": "10" },{ "key": "offset", "value": "0" }] }
          }
        },
        {
          "name": "POST /api/v1/products",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{access_token}}" }
            ],
            "body": { "mode": "raw", "raw": "{\"name\":\"Test Product\",\"sku\":\"TEST-001\",\"price\":5000,\"stock_quantity\":100,\"min_stock_level\":10}" },
            "url": { "raw": "{{base_url}}/api/v1/products", "host": ["{{base_url}}"], "path": ["api","v1","products"] }
          }
        }
      ]
    },
    {
      "name": "Customers",
      "item": [
        {
          "name": "GET /api/v1/customers",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{access_token}}" }],
            "url": { "raw": "{{base_url}}/api/v1/customers?limit=10&offset=0", "host": ["{{base_url}}"], "path": ["api","v1","customers"], "query": [{ "key": "limit", "value": "10" },{ "key": "offset", "value": "0" }] }
          }
        },
        {
          "name": "POST /api/v1/customers",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{access_token}}" }
            ],
            "body": { "mode": "raw", "raw": "{\"name\":\"Test Customer\",\"email\":\"customer@example.com\",\"phone\":\"+959123456789\",\"address\":\"Yangon, Myanmar\"}" },
            "url": { "raw": "{{base_url}}/api/v1/customers", "host": ["{{base_url}}"], "path": ["api","v1","customers"] }
          }
        }
      ]
    }
  ],
  "variable": [
    { "key": "base_url", "value": "http://localhost:8000" },
    { "key": "access_token", "value": "" },
    { "key": "product_id", "value": "" }
  ]
}
