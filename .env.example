# Copy to .env for local development. Never commit .env.

POSTGRES_USER=erp
POSTGRES_PASSWORD=replace-with-random-development-secret
POSTGRES_DB=erp_solution
DATABASE_URL=postgresql://erp:replace-with-random-development-secret@localhost:5432/erp_solution
