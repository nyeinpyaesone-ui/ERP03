# ERP03 backend settings template.
# Copy to .env and fill in real values. Settings uses extra="forbid" — DO NOT
# add keys that are not declared in ERP-BACKEND/app/core/config.py.

# --- Core (required in production; defaults are for development only) ---
SECRET_KEY=change-me-in-production-min-32-characters
ENVIRONMENT=development
LOG_LEVEL=INFO

# --- CORS (comma-separated origins; production must be https and non-local) ---
CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# --- Database ---
# Production/postgres-full profile: postgresql+asyncpg://user:pass@postgres:5432/erp03
DATABASE_URL=sqlite+aiosqlite:////app/.local/erp03.sqlite3
# Journal store path (SQLite fallback / dev); must be a mounted volume in containers
DATABASE_PATH=./.local/erp03.sqlite3

# --- Database pool (auto-tuned by ENVIRONMENT; set only to override) ---
# DB_POOL_SIZE=10
# DB_MAX_OVERFLOW=20
# DB_POOL_RECYCLE=1800
# DB_ECHO=false

# --- TypeSafe System One (optional; disabled by default) ---
# TYPESAFE_ENABLED=true
# TYPESAFE_API_KEY=your-typesafe-api-key

# --- Compose-only variables (not passed into the app container) ---
# POSTGRES_DB=erp03
# POSTGRES_USER=erp03
# POSTGRES_PASSWORD=set-a-real-password
# GHCR_IMAGE_BACKEND=ghcr.io/nyeinpyaesone-ui/erp03-backend
# GHCR_IMAGE_FRONTEND=ghcr.io/nyeinpyaesone-ui/erp03-frontend
# IMAGE_TAG=latest
