# ERP03 Environment Template — Copy to .env and fill in values
# NEVER commit real credentials to version control

# Core
ENVIRONMENT=development
SECRET_KEY=your-secret-key-min-32-chars
LOG_LEVEL=DEBUG

# Database (SQLite for dev, PostgreSQL for production)
DATABASE_URL=sqlite+aiosqlite:///./.local/erp03.sqlite3
DATABASE_PATH=./.local/erp03.sqlite3

# Database Pool (auto-tuned by ENVIRONMENT)
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=10
DB_POOL_RECYCLE=1800
DB_ECHO=false

# Redis (optional)
REDIS_URL=redis://localhost:6379/0
REDIS_PASSWORD=
REDIS_DB=0

# CORS
CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# TypeSafe (optional)
TYPESAFE_ENABLED=false
TYPESAFE_API_KEY=

# JWT
JWT_EXPIRY_MINUTES=30

# Auth
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7
PASSWORD_MIN_LENGTH=12
BCRYPT_ROUNDS=12

# Idempotency
IDEMPOTENCY_TTL_HOURS=24
IDEMPOTENCY_CLEANUP_INTERVAL=3600

# Rate Limiting
RATE_LIMIT_ENABLED=true
RATE_LIMIT_REQUESTS=100
RATE_LIMIT_WINDOW=60

# Webhooks
WEBHOOK_SECRET=
WEBHOOK_TIMEOUT=30

# Observability
OTEL_ENABLED=false
OTEL_EXPORTER_OTLP_ENDPOINT=

# Debug
DEBUG=true
