# Local development environment for `docker compose up`.
# Copy to .env and fill in real values:  cp .env.example .env
# .env is gitignored — never commit real credentials.

# --- Core -------------------------------------------------------------------
# Must be at least 32 characters and must not be the placeholder below in
# production; the API refuses to start otherwise.
SECRET_KEY=replace-with-a-random-32-byte-secret
ENVIRONMENT=development
LOG_LEVEL=INFO

# --- PostgreSQL -------------------------------------------------------------
POSTGRES_DB=erp03
POSTGRES_USER=erp03
POSTGRES_PASSWORD=replace-with-a-strong-password
DATABASE_URL=postgresql+asyncpg://erp03:replace-with-a-strong-password@postgres:5432/erp03

# --- Redis ------------------------------------------------------------------
REDIS_URL=redis://redis:6379/0

# --- Browser access ---------------------------------------------------------
# Comma separated. Localhost entries are rejected when ENVIRONMENT=production.
CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# --- Local AI (optional) ----------------------------------------------------
OLLAMA_BASE_URL=http://ollama:11434
OLLAMA_MODEL=qwen2.5:1.5b
