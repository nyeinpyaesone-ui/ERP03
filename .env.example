# Database Configuration
DB_USER=erp
DB_PASSWORD=your_secure_password_here
DB_NAME=erp_solution
POSTGRES_DB=erp03_prod
POSTGRES_USER=erp
POSTGRES_PASSWORD=your_secure_password_here

# Redis Configuration
REDIS_URL=redis://localhost:6379/0
REDIS_PASSWORD=your_redis_password_here

# Celery Worker Configuration
CELERY_CONCURRENCY=4
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/0
CELERY_MAX_TASKS_PER_CHILD=100
CELERY_PREFETCH_MULTIPLIER=1

# Flower Monitoring
FLOWER_USER=admin
FLOWER_PASSWORD=admin_change_me

# Application Security
SECRET_KEY=your_super_secret_key_min_32_chars_here
JWT_SECRET=your_jwt_secret_key_min_32_chars_here
CORS_ORIGINS=http://localhost:3000,https://erp.yourdomain.com

# Environment
ENVIRONMENT=development
LOG_LEVEL=INFO
ALLOW_PRODUCTION_SEEDING=false

# Optional: For production with external database
# DATABASE_URL=postgresql://user:password@host:5432/dbname
