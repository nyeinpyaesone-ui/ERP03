# ERP03 backend configuration — copy to .env and adjust for your environment.
# Never commit .env — it is gitignored.

ENVIRONMENT=development
SECRET_KEY=replace-with-a-random-32-byte-secret
POSTGRES_DB=erp03
POSTGRES_USER=erp03
POSTGRES_PASSWORD=replace-with-a-strong-password

# Transactional database (SQLAlchemy async). Use the PostgreSQL URL in
# production; a sqlite+aiosqlite:/// URL is acceptable for local development.
DATABASE_URL=sqlite+aiosqlite:////app/.local/erp03.sqlite3

# Durable transaction journal path (SQLite file used by /api/v1/transactions).
# Must match DATABASE_PATH in docker-compose.yml and config.py default.
DATABASE_PATH=./.local/erp03.sqlite3

CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# --- Docker / GHCR container registry configuration ---
# Used by docker-compose and CI container workflows.
GHCR_REGISTRY=ghcr.io
GHCR_USERNAME=${GHCR_ACTOR:-nyeinpyaesone-ui}
GHCR_TOKEN=${GITHUB_TOKEN:-replace-with-a-github-token-with-write-packages}
GHCR_IMAGE_BACKEND=ghcr.io/nyeinpyaesone-ui/erp03-backend
GHCR_IMAGE_FRONTEND=ghcr.io/nyeinpyaesone-ui/erp03-frontend
IMAGE_TAG=${IMAGE_TAG:-latest}

# --- Observability configuration ---
OTEL_EXPORTER_OTLP_ENDPOINT=http://otel-collector:4317
OTEL_SERVICE_NAME=erp03-backend
OTEL_ENVIRONMENT=production
GF_SECURITY_ADMIN_PASSWORD=replace-with-a-secure-admin-password
