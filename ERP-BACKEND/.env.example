# ERP03 backend settings template. Copy to ERP-BACKEND/.env.
# Settings uses extra="forbid"; only declared settings are accepted.

SECRET_KEY=set-a-real-secret-key-min-32-chars
ENVIRONMENT=development
LOG_LEVEL=INFO
DEBUG=false
CORS_ORIGINS=http://localhost:3000,http://localhost:5173

DATABASE_URL=sqlite+aiosqlite:///./.local/erp03.sqlite3
DATABASE_PATH=./.local/erp03.sqlite3

# Optional Supabase Auth bridge. Both values are required together.
# Use the project URL and publishable key only; never use a service-role,
# secret API key, or JWT signing secret here.
# SUPABASE_URL=https://your-project-ref.supabase.co
# SUPABASE_PUBLISHABLE_KEY=sb_publishable_your_public_key

JWT_EXPIRY_MINUTES=480
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7
PASSWORD_MIN_LENGTH=12
BCRYPT_ROUNDS=12

API_V1_PREFIX=/api/v1
API_TITLE=ERP03 API
API_VERSION=1.1.0
API_DOCS_URL=/docs
API_REDOC_URL=/redoc

IDEMPOTENCY_TTL_HOURS=24
IDEMPOTENCY_CLEANUP_INTERVAL=3600
RATE_LIMIT_ENABLED=true
RATE_LIMIT_REQUESTS=100
RATE_LIMIT_WINDOW=60

WEBHOOK_TIMEOUT=30
OTEL_ENABLED=false
