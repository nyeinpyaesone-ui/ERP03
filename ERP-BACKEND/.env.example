# ERP03 backend settings template (read by app/core/config.py from
# ERP-BACKEND/.env). Copy:  cp ERP-BACKEND/.env.example ERP-BACKEND/.env
# Settings uses extra="forbid" — declare ONLY fields that exist in config.py.

# --- Core ---
SECRET_KEY=change-me-min-32-characters-for-production
ENVIRONMENT=development
LOG_LEVEL=INFO
DEBUG=false

# --- CORS (comma-separated; production must be https and non-local) ---
CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# --- Database ---
# Production / compose full profile: postgresql+asyncpg://erp03:<pass>@postgres:5432/erp03
DATABASE_URL=sqlite+aiosqlite:////app/.local/erp03.sqlite3
# Journal store path (SQLite); must live under the mounted volume in containers
DATABASE_PATH=./.local/erp03.sqlite3

# --- Database pool (auto-tuned by ENVIRONMENT; set only to override) ---
# DB_POOL_SIZE=10
# DB_MAX_OVERFLOW=20
# DB_POOL_RECYCLE=1800
# DB_ECHO=false

# --- Redis (optional, for caching/sessions) ---
# REDIS_URL=redis://localhost:6379/0
# REDIS_PASSWORD=
# REDIS_DB=0

# --- TypeSafe System One (optional; disabled by default) ---
# TYPESAFE_ENABLED=true
# TYPESAFE_API_KEY=your-typesafe-api-key

# --- JWT ---
# JWT access token expiry in minutes (default 480 = 8 hours).
JWT_EXPIRY_MINUTES=480
# Access token expiry for auth endpoints (default 30 min)
ACCESS_TOKEN_EXPIRE_MINUTES=30
# Refresh token expiry in days
REFRESH_TOKEN_EXPIRE_DAYS=7
# Password policy
PASSWORD_MIN_LENGTH=8
BCRYPT_ROUNDS=12

# --- API metadata ---
API_V1_PREFIX=/api/v1
API_TITLE=ERP03 API
API_VERSION=1.0.0
API_DOCS_URL=/docs
API_REDOC_URL=/redoc

# --- Idempotency ---
IDEMPOTENCY_TTL_HOURS=24
IDEMPOTENCY_CLEANUP_INTERVAL=3600

# --- Rate limiting ---
RATE_LIMIT_ENABLED=true
RATE_LIMIT_REQUESTS=100
RATE_LIMIT_WINDOW=60

# --- Webhooks ---
# WEBHOOK_SECRET=your-webhook-secret
WEBHOOK_TIMEOUT=30

# --- Observability ---
OTEL_ENABLED=false
# OTEL_EXPORTER_OTLP_ENDPOINT=http://otel-collector:4317