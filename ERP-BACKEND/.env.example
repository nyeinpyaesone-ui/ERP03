# ERP03 backend configuration — copy to .env and adjust for your environment.
ENVIRONMENT=development
SECRET_KEY=replace-with-a-random-32-byte-secret
POSTGRES_DB=erp03
POSTGRES_USER=erp03
POSTGRES_PASSWORD=replace-with-a-strong-password
# Transactional database (SQLAlchemy async). Use the PostgreSQL URL in
# production; a sqlite+aiosqlite:/// URL is acceptable for local development.
DATABASE_URL=postgresql+asyncpg://erp03:replace-with-a-strong-password@postgres:5432/erp03
# Durable transaction journal path (SQLite file used by /api/v1/transactions).
DATABASE_PATH=/data/erp03.sqlite3
CORS_ORIGINS=http://localhost:3000,http://localhost:5173
