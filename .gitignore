```gitignore
# Python cache
__pycache__/
*.pyc
*.pyo
*.pyd

# Dependencies
node_modules/
frontend/node_modules/

# Environment variables
.env
.env.local
.env.*

# Build outputs
dist/
build/
frontend/dist/

# Logs
*.log

# Temporary files
*.tmp
*.swp
*.swo

# OS generated files
.DS_Store
Thumbs.db

# IDE files
.vscode/
.idea/

# Python virtual environments
venv/
.venv/
ERP-BACKEND/venv/
ERP-BACKEND/.venv/

# Coverage reports
coverage/
htmlcov/

# Package lock files
frontend/node_modules/.package-lock.json

# TypeScript build output
frontend/node_modules/@typescript/typescript-linux-x64/

# Rollup and other build artifacts in node_modules
frontend/node_modules/@rollup/
frontend/node_modules/@esbuild/

# Browser mapping baseline
frontend/node_modules/baseline-browser-mapping/

# Agent base for node modules
frontend/node_modules/agent-base/

# Various node module binaries
frontend/node_modules/.bin/
```