# Copy to /etc/erp03/github-webhook.env on the remote server.
GITHUB_WEBHOOK_SECRET=replace-with-a-long-random-secret
GITHUB_REPOSITORY=nyeinpyaesone-ui/ERP03
GITHUB_BRANCH=main
WEBHOOK_HOST=127.0.0.1
WEBHOOK_PORT=9001
DEPLOY_SCRIPT=/opt/erp03/deploy-from-github.sh
# Keep false when Docker images are published by CI and deployment should wait for workflow_run success.
DEPLOY_ON_PUSH=false
