# Copy to /etc/erp03/github-webhook.env on the remote server.
GITHUB_WEBHOOK_SECRET=replace-with-a-long-random-secret
GITHUB_REPOSITORY=nyeinpyaesone-ui/ERP03
GITHUB_BRANCH=main
# GHCR credentials are required when the packages are private.
# Use a dedicated least-privilege GitHub token with read:packages only.
GHCR_USERNAME=nyeinpyaesone-ui
GHCR_TOKEN=replace-with-a-read-packages-token
# Nginx runs in Docker and reaches the host receiver through host.docker.internal.
# Restrict TCP/9001 with the host firewall so it is not publicly reachable.
WEBHOOK_HOST=0.0.0.0
WEBHOOK_PORT=9001
DEPLOY_SCRIPT=/opt/erp03/ops/github-webhook/deploy-from-github.sh
DEPLOY_ON_PUSH=false
