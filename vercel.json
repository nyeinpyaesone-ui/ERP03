{
  "version": 2,
  "framework": "vite",
  "installCommand": "npm --prefix frontend install --no-audit --no-fund",
  "buildCommand": "npm --prefix frontend run build",
  "outputDirectory": "frontend/dist",
  "rewrites": [
    { "source": "/login", "destination": "/index.html" },
    { "source": "/register", "destination": "/index.html" },
    { "source": "/sales", "destination": "/index.html" },
    { "source": "/products", "destination": "/index.html" },
    { "source": "/customers", "destination": "/index.html" },
    { "source": "/inventory", "destination": "/index.html" }
  ]
}
