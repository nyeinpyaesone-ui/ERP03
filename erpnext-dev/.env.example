# ERPNext Development Environment Configuration
# Copy this file to .env and customize for your environment

# =============================================================================
# VERSION CONFIGURATION
# =============================================================================
ERPNEXT_VERSION=v16.31.1
FRAPPE_BRANCH=version-16
FRAPPE_PATH=https://github.com/frappe/frappe

# =============================================================================
# CUSTOM IMAGE CONFIGURATION
# =============================================================================
# Use 'erp03-erpnext:dev' for local development builds
# Use 'ghcr.io/nyeinpyaesone-ui/erp03-erpnext:<commit-sha>' for production
CUSTOM_IMAGE=erp03-erpnext:dev
PULL_POLICY=IfNotPresent

# =============================================================================
# SITE CONFIGURATION
# =============================================================================
# Domain name for accessing ERPNext (use erp.localhost for local dev)
SITE_NAME=erp.localhost
SITES_RULE=Host(`erp.localhost`)

# Let's Encrypt email (only for production with HTTPS)
LETSENCRYPT_EMAIL=admin@example.com

# =============================================================================
# DATABASE CONFIGURATION
# =============================================================================
# IMPORTANT: Change these values for production!
DB_PASSWORD=development_password_123
DB_HOST=db
DB_PORT=3306

# =============================================================================
# REDIS CONFIGURATION
# =============================================================================
REDIS_CACHE=redis://redis-cache:6379
REDIS_QUEUE=redis://redis-queue:6379
REDIS_SOCKETIO=redis://redis-socketio:6379

# =============================================================================
# APPLICATION SERVER CONFIGURATION
# =============================================================================
GUNICORN_WORKERS=2
GUNICORN_THREADS=4
GUNICORN_TIMEOUT=120
SOCKETIO_PORT=9000

# =============================================================================
# ADMIN CONFIGURATION
# =============================================================================
ADMIN_PASSWORD=admin123

# =============================================================================
# MIGRATION CONFIGURATION
# =============================================================================
MIGRATE_SITES=true

# =============================================================================
# DEVELOPMENT OPTIONS
# =============================================================================
# Set to 'true' to enable verbose logging
DEBUG=false

# Enable/disable specific services
ENABLE_SCHEDULER=true
ENABLE_WORKER=true
ENABLE_WEBSOCKET=true
