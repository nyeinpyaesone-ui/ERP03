# ERP03 production environment template.
# Do not copy secrets into this file. Prefer Docker/Kubernetes secret files or a secret manager.

POSTGRES_DB=erp03_prod
REDIS_URL=redis://redis:6379/0
ENVIRONMENT=production
LOG_LEVEL=INFO
CORS_ORIGINS=https://erp.example.com
API_PORT=8000
WEB_PORT=80
CELERY_CONCURRENCY=2

# Optional external integrations
# OLLAMA_BASE_URL=http://ollama:11434
# STRIPE_SECRET_KEY=replace-me
# STRIPE_WEBHOOK_SECRET=replace-me

# Required runtime secrets are mounted separately:
# /run/secrets/db_user
# /run/secrets/db_password
# /run/secrets/jwt_secret
