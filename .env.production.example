# ERP03 Production Environment Configuration Template
# COPY THIS FILE TO .env.production AND UPDATE VALUES
# NEVER commit .env.production to git

# =============================================================================
# DATABASE CONFIGURATION (REQUIRED)
# =============================================================================
POSTGRES_USER=erp03_prod_user
POSTGRES_PASSWORD=<GENERATE_SECURE_PASSWORD>
POSTGRES_DB=erp03_prod
DATABASE_URL=postgresql+asyncpg://erp03_prod_user:<PASSWORD>@db:5432/erp03_prod

# Generate secure password: openssl rand -base64 24

# =============================================================================
# REDIS CONFIGURATION (REQUIRED)
# =============================================================================
REDIS_URL=redis://:<REDIS_PASSWORD>@redis:6379/0
# Generate Redis password: openssl rand -base64 24

# =============================================================================
# SECURITY (REQUIRED)
# =============================================================================
SECRET_KEY=<GENERATE_SECURE_SECRET>
# Generate SECRET_KEY: openssl rand -hex 32 (minimum 32 characters)

JWT_SECRET=<GENERATE_SECURE_SECRET>
# Generate JWT secret: openssl rand -hex 32

APP_SECRET=<GENERATE_SECURE_SECRET>
# Generate APP secret: openssl rand -hex 32

ENVIRONMENT=production
LOG_LEVEL=INFO

# =============================================================================
# CORS (OPTIONAL - Configure for your domain)
# =============================================================================
# CORS_ORIGINS=https://erp.yourdomain.com

# =============================================================================
# OIDC AUTHENTICATION (OPTIONAL - For OAuth2/OpenID Connect login)
# =============================================================================
# Enable OIDC authentication (set to 'true' to enable)
OIDC_ENABLED=false

# OIDC Provider name (e.g., keycloak, google, auth0, azure, okta)
OIDC_PROVIDER=keycloak

# OAuth2 Client Credentials (get from your OIDC provider)
OIDC_CLIENT_ID=erpnext-client
OIDC_CLIENT_SECRET=<YOUR_CLIENT_SECRET>

# Redirect URI (must match what's configured in your OIDC provider)
# Format: https://your-domain.com/api/method/frappe.integrations.oauth2_logins.login/<provider>
OIDC_REDIRECT_URI=https://erp.yourdomain.com/api/method/frappe.integrations.oauth2_logins.login/keycloak

# OAuth2 Scopes (space-separated)
OIDC_SCOPE=openid profile email

# OIDC Endpoints (required for generic providers like Keycloak)
# Get these from your OIDC provider's discovery endpoint
# Example: https://auth.yourdomain.com/realms/myrealm/.well-known/openid-configuration
OIDC_AUTHORIZATION_URL=https://auth.yourdomain.com/realms/myrealm/protocol/openid-connect/auth
OIDC_TOKEN_URL=https://auth.yourdomain.com/realms/myrealm/protocol/openid-connect/token
OIDC_USERINFO_URL=https://auth.yourdomain.com/realms/myrealm/protocol/openid-connect/userinfo
OIDC_JWKS_URL=https://auth.yourdomain.com/realms/myrealm/protocol/openid-connect/certs
OIDC_ISSUER=https://auth.yourdomain.com/realms/myrealm

# Pre-configured Providers (optional - set if using a known provider)
# For Google:
# OIDC_PROVIDER=google
# OIDC_AUTHORIZATION_URL=https://accounts.google.com/o/oauth2/v2/auth
# OIDC_TOKEN_URL=https://oauth2.googleapis.com/token
# OIDC_USERINFO_URL=https://www.googleapis.com/oauth2/v3/userinfo
# OIDC_JWKS_URL=https://www.googleapis.com/oauth2/v3/certs
# OIDC_ISSUER=https://accounts.google.com

# For Auth0:
# OIDC_PROVIDER=auth0
# OIDC_AUTHORIZATION_URL=https://your-tenant.auth0.com/authorize
# OIDC_TOKEN_URL=https://your-tenant.auth0.com/oauth/token
# OIDC_USERINFO_URL=https://your-tenant.auth0.com/userinfo
# OIDC_JWKS_URL=https://your-tenant.auth0.com/.well-known/jwks.json
# OIDC_ISSUER=https://your-tenant.auth0.com/

# For Azure AD:
# OIDC_PROVIDER=azure
# OIDC_AUTHORIZATION_URL=https://login.microsoftonline.com/<tenant-id>/oauth2/v2.0/authorize
# OIDC_TOKEN_URL=https://login.microsoftonline.com/<tenant-id>/oauth2/v2.0/token
# OIDC_USERINFO_URL=https://graph.microsoft.com/oidc/userinfo
# OIDC_JWKS_URL=https://login.microsoftonline.com/<tenant-id>/discovery/v2.0/keys
# OIDC_ISSUER=https://login.microsoftonline.com/<tenant-id>/v2.0

# =============================================================================
# EXTERNAL SERVICES (OPTIONAL)
# =============================================================================
# OLLAMA_BASE_URL=http://ollama:11434
# STRIPE_SECRET_KEY=sk_live_...

# =============================================================================
# SECURITY NOTES:
# - Generate all passwords/secrets using openssl or similar
# - Store secrets in a secure vault (AWS Secrets Manager, HashiCorp Vault)
# - Rotate secrets every 90-180 days
# - Use different secrets for each environment
# - Never share production secrets via insecure channels
# - For OIDC: Ensure redirect URIs match exactly between provider and this config
# =============================================================================
