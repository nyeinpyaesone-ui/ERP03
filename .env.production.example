# ERP03 Production Environment Configuration Template
# COPY THIS FILE TO .env.production AND UPDATE VALUES
# NEVER commit .env.production to git

# =============================================================================
# DATABASE CONFIGURATION (REQUIRED)
# =============================================================================
POSTGRES_USER=erp03_prod_user
POSTGRES_PASSWORD=<GENERATE_SECURE_PASSWORD>
POSTGRES_DB=erp03_prod
DATABASE_URL=postgresql+asyncpg://erp03_prod_user:<PASSWORD>@db:5432/erp03_prod

# Generate secure password: openssl rand -base64 24

# =============================================================================
# REDIS CONFIGURATION (REQUIRED)
# =============================================================================
REDIS_URL=redis://:<REDIS_PASSWORD>@redis:6379/0
# Generate Redis password: openssl rand -base64 24

# =============================================================================
# SECURITY (REQUIRED)
# =============================================================================
JWT_SECRET=<GENERATE_SECURE_SECRET>
# Generate JWT secret: openssl rand -hex 32

APP_SECRET=<GENERATE_SECURE_SECRET>
# Generate APP secret: openssl rand -hex 32

ENVIRONMENT=production
LOG_LEVEL=INFO

# =============================================================================
# CORS (OPTIONAL - Configure for your domain)
# =============================================================================
# CORS_ORIGINS=https://erp.yourdomain.com

# =============================================================================
# EXTERNAL SERVICES (OPTIONAL)
# =============================================================================
# OLLAMA_BASE_URL=http://ollama:11434
# STRIPE_SECRET_KEY=sk_live_...

# =============================================================================
# SECURITY NOTES:
# - Generate all passwords/secrets using openssl or similar
# - Store secrets in a secure vault (AWS Secrets Manager, HashiCorp Vault)
# - Rotate secrets every 90-180 days
# - Use different secrets for each environment
# - Never share production secrets via insecure channels
# =============================================================================
