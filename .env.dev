# ============================================
# ERP erpo3 - Development Environment Configuration
# ============================================
# Copy this file to .env.dev and customize for your local development setup
# ============================================

# --------------------------------------------
# Database Configuration (PostgreSQL)
# --------------------------------------------
POSTGRES_USER=erp_dev
POSTGRES_PASSWORD=dev_password_change_in_production
POSTGRES_DB=erp03_dev
DB_HOST=localhost
DB_PORT=5432

# Database URL for applications
DATABASE_URL=postgresql+asyncpg://erp_dev:dev_password_change_in_production@localhost:5432/erp03_dev

# --------------------------------------------
# Redis Configuration
# --------------------------------------------
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_URL=redis://localhost:6379/0
REDIS_PASSWORD=

# --------------------------------------------
# Celery Worker Configuration
# --------------------------------------------
CELERY_CONCURRENCY=2
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/0
CELERY_MAX_TASKS_PER_CHILD=50
CELERY_PREFETCH_MULTIPLIER=1

# --------------------------------------------
# Flower Monitoring (Celery Dashboard)
# --------------------------------------------
FLOWER_USER=dev_admin
FLOWER_PASSWORD=dev_flower_password

# --------------------------------------------
# Application Security
# --------------------------------------------
# Generate a secure secret key: python -c "import secrets; print(secrets.token_urlsafe(32))"
SECRET_KEY=dev_secret_key_CHANGE_THIS_IN_PRODUCTION_min_32_chars
JWT_SECRET=dev_jwt_secret_CHANGE_THIS_IN_PRODUCTION_min_32_chars
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7

# CORS Configuration
CORS_ORIGINS=http://localhost:3000,http://localhost:5173,http://localhost:8080
CORS_ALLOW_CREDENTIALS=true
CORS_ALLOW_METHODS=*
CORS_ALLOW_HEADERS=*

# --------------------------------------------
# Environment Settings
# --------------------------------------------
ENVIRONMENT=development
DEBUG=true
LOG_LEVEL=DEBUG
ALLOW_PRODUCTION_SEEDING=false

# --------------------------------------------
# API Configuration
# --------------------------------------------
API_HOST=0.0.0.0
API_PORT=8000
API_WORKERS=2
API_RELOAD=true

# --------------------------------------------
# Frontend Configuration (Vite)
# --------------------------------------------
VITE_API_BASE_URL=http://localhost:8000/api/v1
VITE_APP_VERSION=dev
VITE_APP_NAME=ERP erpo3
VITE_DEBUG_MODE=true

# --------------------------------------------
# Docker & Container Configuration
# --------------------------------------------
DOCKER_REGISTRY=ghcr.io
DOCKER_IMAGE_PREFIX=erpo3
CONTAINER_PREFIX=erp03

# --------------------------------------------
# GitHub Container Registry (GHCR)
# --------------------------------------------
GHCR_REGISTRY=ghcr.io
GHCR_USERNAME=your-github-username
# GHCR_TOKEN should be set as a secret, not in this file
# GHCR_TOKEN=ghp_your_personal_access_token

# --------------------------------------------
# Optional: External Services
# --------------------------------------------
# SMTP Configuration (for email notifications)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=noreply@erpo3.dev

# Storage Configuration (S3-compatible)
S3_ENDPOINT_URL=
S3_BUCKET_NAME=
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_REGION=us-east-1

# --------------------------------------------
# Feature Flags
# --------------------------------------------
ENABLE_CELERY_WORKER=true
ENABLE_FLOWER_MONITORING=true
ENABLE_API_DOCS=true
ENABLE_HEALTH_CHECKS=true
ENABLE_METRICS=true

# --------------------------------------------
# Rate Limiting
# --------------------------------------------
RATE_LIMIT_PER_MINUTE=60
RATE_LIMIT_BURST=10

# --------------------------------------------
# Session Configuration
# --------------------------------------------
SESSION_COOKIE_NAME=erp_session
SESSION_COOKIE_SECURE=false
SESSION_COOKIE_HTTPONLY=true
SESSION_COOKIE_SAMESITE=lax
PERMANENT_SESSION_LIFETIME_DAYS=7
