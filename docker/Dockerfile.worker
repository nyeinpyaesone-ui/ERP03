# ERP Celery Worker Dockerfile
# Multi-stage build for Python Celery workers with memory control

FROM python:3.12-slim AS builder

WORKDIR /app

# Install build dependencies
RUN apt-get update && apt-get install -y --no-install-recommends \
    gcc \
    libpq-dev \
    && rm -rf /var/lib/apt/lists/*

# Copy and install Python dependencies
COPY ERP-BACKEND/requirements.txt .
RUN pip install --no-cache-dir --user -r requirements.txt

# Copy application code
COPY ERP-BACKEND/app ./app
COPY ERP-BACKEND/alembic.ini ./

# Stage 2: Production image
FROM python:3.12-slim AS production

# Create non-root user
RUN groupadd -r celerygroup && useradd -r -g celerygroup celeryuser

WORKDIR /app

# Copy installed packages from builder
COPY --from=builder /root/.local /home/celeryuser/.local

# Copy application code
COPY --from=builder /app/app ./app
COPY --from=builder /app/alembic.ini ./

# Set environment variables
ENV PATH=/home/celeryuser/.local/bin:$PATH \
    PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1

# Change ownership
RUN chown -R celeryuser:celerygroup /app

USER celeryuser

# Health check using celery inspect
HEALTHCHECK --interval=30s --timeout=10s --start-period=30s --retries=3 \
  CMD python -c "from app.workers.celery_app import celery_app; print('OK')" || exit 1

# Default command (overridden in docker-compose)
CMD ["celery", "-A", "app.workers.celery_app", "worker", "--loglevel=info"]

