{
  "name": "@erp03/rlm-service",
  "version": "1.0.0",
  "description": "ERP03 Repository Lifecycle Management Service",
  "main": "dist/index.js",
  "scripts": {
    "dev": "ts-node-dev --respawn src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "test": "jest",
    "lint": "eslint src/**/*.ts",
    "format": "prettier --write \"src/**/*.ts\""
  },
  "keywords": [
    "github",
    "repository",
    "lifecycle",
    "automation",
    "devops"
  ],
  "author": "ERP03 DevOps Team",
  "license": "MIT",
  "dependencies": {
    "express": "^4.18.2",
    "crypto": "^1.0.1",
    "body-parser": "^1.20.2",
    "ioredis": "^5.3.2",
    "dotenv": "^16.3.1",
    "axios": "^1.6.0",
    "@octokit/rest": "^20.0.2",
    "@octokit/app": "^14.0.2",
    "winston": "^3.11.0",
    "express-rate-limit": "^7.1.5"
  },
  "devDependencies": {
    "typescript": "^5.3.2",
    "@types/node": "^20.10.0",
    "@types/express": "^4.17.21",
    "@types/body-parser": "^1.19.5",
    "ts-node": "^10.9.2",
    "ts-node-dev": "^2.0.0",
    "jest": "^29.7.0",
    "@types/jest": "^29.5.11",
    "eslint": "^8.55.0",
    "@typescript-eslint/eslint-plugin": "^6.13.0",
    "@typescript-eslint/parser": "^6.13.0",
    "prettier": "^3.1.0"
  },
  "engines": {
    "node": ">=20.0.0"
  }
}
