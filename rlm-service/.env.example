# RLM Service Environment Configuration
# Copy this file to .env and fill in your values

# Service Configuration
PORT=3000
NODE_ENV=development
LOG_LEVEL=info

# GitHub Integration (Required - Set in GitHub Secrets for production)
# These should be injected via Codespace secrets, not hardcoded
WEBHOOK_GITHUB_KEY=
WEBHOOK_GITHUB_URL=
GITHUB_APP_ID=
GITHUB_APP_PRIVATE_KEY=
REPO_OWNER=nyeinpyaesone-ui
REPO_NAME=ERP03
PROJECT_NUMBER=29

# Redis Configuration
REDIS_URL=redis://localhost:6379
REDIS_QUEUE_NAME=rlm_events

# Security Configuration
HMAC_ALGORITHM=sha256
SIGNATURE_HEADER=X-Hub-Signature-256
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_REQUESTS=100

# Monitoring
ENABLE_METRICS=true
METRICS_PORT=9090
