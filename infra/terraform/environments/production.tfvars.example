aws_region = "us-east-1"
vpc_cidr   = "10.2.0.0/16"

# Reference an existing AWS Secrets Manager secret; do not put the password itself here.
db_password_secret_arn = "arn:aws:secretsmanager:us-east-1:ACCOUNT_ID:secret:erp03/production/db-password"

# Supply through a protected CI/CD variable or secret manager integration.
redis_auth_token = "SET_VIA_SECURE_CI_VARIABLE"
