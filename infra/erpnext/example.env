# ERPNext / Frappe Docker production configuration
# Copy to .env on the deployment host. Never commit production secrets.

ERPNEXT_VERSION=v16.31.1
FRAPPE_BRANCH=version-16
FRAPPE_PATH=https://github.com/frappe/frappe

# Custom image produced by CI
CUSTOM_IMAGE=ghcr.io/nyeinpyaesone-ui/erp03-erpnext
CUSTOM_TAG=v16.31.1
PULL_POLICY=always

# Site / routing
SITE_NAME=erp.example.com
SITES_RULE=Host(`erp.example.com`)
LETSENCRYPT_EMAIL=admin@example.com

# Database / Redis — replace with production secret values
DB_PASSWORD=CHANGE_ME
REDIS_CACHE=redis-cache:6379
REDIS_QUEUE=redis-queue:6379

# Runtime tuning
GUNICORN_WORKERS=2
GUNICORN_THREADS=4
GUNICORN_TIMEOUT=120

# Migration gate
MIGRATE_SITES=true
