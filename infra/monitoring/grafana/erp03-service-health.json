{
  "title": "ERP03 Service Health",
  "uid": "erp03-service-health",
  "schemaVersion": 39,
  "version": 1,
  "editable": true,
  "timezone": "browser",
  "refresh": "30s",
  "time": { "from": "now-6h", "to": "now" },
  "templating": {
    "list": [
      {
        "name": "environment",
        "type": "query",
        "datasource": { "type": "prometheus", "uid": "${datasource}" },
        "query": "label_values(up{job=\"erp03-backend\"}, environment)",
        "current": { "text": "All", "value": "$__all" },
        "includeAll": true,
        "multi": false
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "type": "timeseries",
      "title": "Request rate by status class",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "targets": [
        {
          "expr": "sum by (status) (rate(erp03_http_requests_total{environment=~\"$environment\"}[5m]))",
          "legendFormat": "{{status}}"
        }
      ],
      "fieldConfig": { "defaults": { "unit": "reqps" }, "overrides": [] }
    },
    {
      "id": 2,
      "type": "timeseries",
      "title": "Latency p50 / p95 / p99",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "targets": [
        {
          "expr": "histogram_quantile(0.50, sum by (le) (rate(erp03_http_request_duration_seconds_bucket{environment=~\"$environment\"}[5m])))",
          "legendFormat": "p50"
        },
        {
          "expr": "histogram_quantile(0.95, sum by (le) (rate(erp03_http_request_duration_seconds_bucket{environment=~\"$environment\"}[5m])))",
          "legendFormat": "p95"
        },
        {
          "expr": "histogram_quantile(0.99, sum by (le) (rate(erp03_http_request_duration_seconds_bucket{environment=~\"$environment\"}[5m])))",
          "legendFormat": "p99"
        }
      ],
      "fieldConfig": { "defaults": { "unit": "s" }, "overrides": [] }
    },
    {
      "id": 3,
      "type": "stat",
      "title": "5xx ratio (5m)",
      "gridPos": { "h": 8, "w": 6, "x": 0, "y": 8 },
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "targets": [
        {
          "expr": "sum(rate(erp03_http_requests_total{environment=~\"$environment\",status=~\"5..\"}[5m])) / sum(rate(erp03_http_requests_total{environment=~\"$environment\"}[5m]))",
          "legendFormat": "5xx ratio"
        }
      ],
      "fieldConfig": { "defaults": { "unit": "percentunit", "thresholds": { "mode": "absolute", "steps": [ { "color": "green", "value": null }, { "color": "yellow", "value": 0.005 }, { "color": "red", "value": 0.01 } ] } }, "overrides": [] }
    },
    {
      "id": 4,
      "type": "stat",
      "title": "API targets up",
      "gridPos": { "h": 8, "w": 6, "x": 6, "y": 8 },
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "targets": [
        { "expr": "sum(up{job=\"erp03-backend\",environment=~\"$environment\"})", "legendFormat": "up" }
      ],
      "fieldConfig": { "defaults": { "unit": "short", "thresholds": { "mode": "absolute", "steps": [ { "color": "red", "value": null }, { "color": "green", "value": 1 } ] } }, "overrides": [] }
    },
    {
      "id": 5,
      "type": "timeseries",
      "title": "Saturation: CPU and memory against limits",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 8 },
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "targets": [
        {
          "expr": "sum by (environment) (rate(container_cpu_usage_seconds_total{container=\"backend\",namespace=~\"erp03-.*\"}[5m])) / sum by (environment) (kube_pod_container_resource_limits{resource=\"cpu\",container=\"backend\",namespace=~\"erp03-.*\"})",
          "legendFormat": "cpu {{environment}}"
        },
        {
          "expr": "sum by (environment) (container_memory_working_set_bytes{container=\"backend\",namespace=~\"erp03-.*\"}) / sum by (environment) (kube_pod_container_resource_limits{resource=\"memory\",container=\"backend\",namespace=~\"erp03-.*\"})",
          "legendFormat": "memory {{environment}}"
        }
      ],
      "fieldConfig": { "defaults": { "unit": "percentunit", "max": 1 }, "overrides": [] }
    },
    {
      "id": 6,
      "type": "table",
      "title": "PostgreSQL connections vs maximum",
      "gridPos": { "h": 8, "w": 24, "x": 0, "y": 16 },
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "targets": [
        {
          "expr": "pg_stat_activity_count{datname=\"erp03\"}",
          "instant": true,
          "legendFormat": "connections"
        }
      ],
      "fieldConfig": { "defaults": { "unit": "short" }, "overrides": [] }
    }
  ]
}
