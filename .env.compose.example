# Compose-only variables — used by docker-compose.yml interpolation ONLY.
# These are NOT read by the ERP03 backend (Settings uses extra="forbid" and
# will refuse to start if this file is copied into the app's .env).
# Copy:  cp .env.compose.example .env.compose   # then: docker compose --env-file .env.compose up

POSTGRES_DB=erp03
POSTGRES_USER=erp03
POSTGRES_PASSWORD=set-a-real-password
REDIS_PASSWORD=set-a-real-redis-password
DOCKERHUB_IMAGE_BACKEND=powerrangeranikg/erp03-backend
DOCKERHUB_IMAGE_FRONTEND=powerrangeranikg/erp03-frontend
IMAGE_TAG=latest

# Backend runtime (injected by compose into backend container)
SECRET_KEY=set-a-real-secret-key-32-chars-min
ENVIRONMENT=production
CORS_ORIGINS=https://your-domain.com
DATABASE_URL=postgresql://erp03:${POSTGRES_PASSWORD}@postgres:5432/erp03