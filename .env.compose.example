# Compose-only variables — used by docker-compose.yml interpolation ONLY.
# These are NOT read by the ERP03 backend (Settings uses extra="forbid" and
# will refuse to start if this file is copied into the app's .env).
# Copy:  cp .env.compose.example .env.compose   # then: docker compose --env-file .env.compose up

POSTGRES_DB=erp03
POSTGRES_USER=erp03
POSTGRES_PASSWORD=set-a-real-password
GHCR_IMAGE_BACKEND=ghcr.io/nyeinpyaesone-ui/erp03-backend
GHCR_IMAGE_FRONTEND=ghcr.io/nyeinpyaesone-ui/erp03-frontend
IMAGE_TAG=latest
