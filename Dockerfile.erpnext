# ERPNext v16.31.1 custom image layer.
# The production GitHub Actions path uses the official frappe_docker layered build;
# this file remains an explicit custom-app extension path for local/controlled builds.
FROM frappe/erpnext:v16.31.1

USER root

COPY --chown=frappe:frappe ./apps/erpnext_custom /home/frappe/bench/apps/erpnext_custom

RUN if [ -f /home/frappe/bench/apps/erpnext_custom/requirements.txt ]; then \
      cd /home/frappe/bench/apps/erpnext_custom && \
      pip install --no-cache-dir -r requirements.txt; \
    fi

RUN cd /home/frappe/bench && \
    bench build --app erpnext_custom

USER frappe

EXPOSE 8000

CMD ["bench", "serve", "--port=8000"]
