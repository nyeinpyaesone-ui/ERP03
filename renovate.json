{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["config:recommended"],
  "packageRules": [
    {
      "matchPackagePatterns": ["ruff", "fastapi", "sqlalchemy", "alembic", "argon2-cffi", "PyJWT"],
      "groupName": "backend-python",
      "automerge": true
    },
    {
      "matchPackagePatterns": ["react", "react-dom", "vite", "nginx"],
      "groupName": "frontend",
      "automerge": true
    },
    {
      "matchPackagePatterns": ["actions/*", "docker/*", "github/codeql-action*"],
      "groupName": "github-actions",
      "automerge": true
    }
  ],
  "prHourlyLimit": 0,
  "prConcurrentLimit": 10,
  "timezone": "UTC",
  "schedule": ["before 3am on monday"],
  "vulnerabilityAlerts": {
    "automerge": true
  }
}
