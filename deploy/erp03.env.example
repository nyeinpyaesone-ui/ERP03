# Copy to /etc/erp03/erp03.env and replace every placeholder.
# Keep root:erp03 ownership and mode 0640. Never commit the real file.
ENVIRONMENT=production
SECRET_KEY=REPLACE_WITH_A_RANDOM_SECRET_OF_AT_LEAST_32_BYTES
DATABASE_URL=postgresql+asyncpg://erp03:REPLACE_WITH_DATABASE_PASSWORD@127.0.0.1:5432/erp03
CORS_ORIGINS=https://erp.example.com
PUBLIC_HOSTNAME=erp.example.com
DATABASE_PATH=/var/lib/erp03/erp03.sqlite3
