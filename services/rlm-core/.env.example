# ERP03 RLM Environment Variables
# Copy this file to .env and fill in your real values

# GitHub Webhook Secret (must match GitHub webhook settings)
WEBHOOK_GITHUB_KEY=your-generated-secret-here

# GitHub Personal Access Token (needs repo scope)
GITHUB_TOKEN=ghp_your-token-here

# Production ERP Endpoint
ERP_WEBHOOK_URL=https://erp.anynoob.com/webhook/

# Server Configuration
PORT=3000
REDIS_URL=redis://localhost:6379
